{
  "name": "minique-marketplace",
  "version": "1.0.0",
  "description": "Fancy second-hand baby clothes marketplace platform",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "client": "cd client && npm start",
